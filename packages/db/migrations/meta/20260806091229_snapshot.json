          "value": "(\n        (\"items\".\"original_url\" is not null and length(btrim(\"items\".\"original_url\")) > 0)\n        or\n        (\"items\".\"note_markdown\" is not null and length(btrim(\"items\".\"note_markdown\")) > 0)\n      )"
