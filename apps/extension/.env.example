# The server origin. Do not include /api/v1.
WXT_API_ORIGIN=http://localhost:3000

# The dashboard origin used by the popup's View Item action.
WXT_WEB_ORIGIN=http://localhost:5173

# Public Chrome Extension OAuth client ID. This is not a client secret.
WXT_GOOGLE_CLIENT_ID=

# Stable 32-character Chrome extension ID assigned to the Web Store draft.
WXT_EXTENSION_ID=

# Release-only public key from the draft Chrome Web Store item's Package tab.
# Remove the PEM header/footer and newlines. Development builds may omit it;
# release builds require it so the extension ID stays stable.
WXT_EXTENSION_PUBLIC_KEY=
